# 复制成 .env 后填入真实值。.env 已在 .gitignore 中,不会被提交。
# 前两项在 Databricks 的 SQL Warehouse -> Connection details 页面直接复制。

DATABRICKS_SERVER_HOSTNAME=<workspace>.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DATABRICKS_TOKEN=<personal access token>

# 可选
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=gmv_rca

# 打开真机测试(tests/test_databricks_live.py 会写入 workspace)
# RCA_LIVE_DATABRICKS=1
# RCA_LIVE_SCHEMA=gmv_rca_test

# ---------------------------------------------------------------------------
# LLM(text-to-SQL 的生成环节)
#
# provider=databricks 时 base_url 由 DATABRICKS_SERVER_HOSTNAME 推导成
#   https://<host>/serving-endpoints —— 请求不出 Databricks。
# 在 Databricks notebook 里运行时这一段都不用设,Runtime 会注入凭据。
# ---------------------------------------------------------------------------
RCA_LLM_PROVIDER=databricks
RCA_LLM_MODEL=databricks-meta-llama-3-3-70b-instruct

# 走外部 API(注意:请求会出站,schema 会离开你的 workspace)
# RCA_LLM_PROVIDER=openai
# RCA_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# 任意 OpenAI 兼容端点
# RCA_LLM_PROVIDER=custom
# RCA_LLM_BASE_URL=https://my-proxy.internal/v1
# RCA_LLM_MODEL=my-model
# RCA_LLM_API_KEY=...

# 预算熔断(不设=不限)
RCA_LLM_MAX_CALLS=200
RCA_LLM_MAX_TOKENS=500000
